---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SkillCard from '../../../components/SkillCard.astro';
import {
  getAllSkills,
  getSkillCategoryById,
  skillCategoryName,
  skillDesc,
  skillUseCases,
} from '../../../lib/skills';
import { t, localePath } from '../../../lib/i18n';
import type { Lang, Skill } from '../../../lib/types';

export function getStaticPaths() {
  return getAllSkills().flatMap((skill) => [
    { params: { lang: undefined, slug: skill.slug }, props: { skill } }, // zh → /skills/slug/
    { params: { lang: 'en', slug: skill.slug }, props: { skill } }, // en → /en/skills/slug/
  ]);
}

const { skill } = Astro.props;
const lang: Lang = (Astro.params.lang as Lang | undefined) ?? 'zh';
const cat = getSkillCategoryById(skill.category);
const desc = skillDesc(skill, lang);
const useCases = skillUseCases(skill, lang);
const related = getAllSkills()
  .filter((item) => item.category === skill.category && item.slug !== skill.slug)
  .slice(0, 6);
const canonicalPath = `/skills/${skill.slug}/`;
const sourceLabel = t(lang, `skills.source.${skill.source}`);
const sourceClass: Record<Skill['source'], string> = {
  official: 'bg-accent/10 text-accent',
  community: 'bg-surface-2 text-muted',
  builtin: 'bg-surface-2 text-muted',
};
---

<BaseLayout
  lang={lang}
  title={skill.name}
  description={desc}
  canonicalPath={canonicalPath}
  ogType="article"
>
  <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <!-- 面包屑 -->
    <nav
      class="mb-6 flex flex-wrap items-center gap-1.5 text-sm text-muted"
      aria-label="Breadcrumb"
    >
      <a href={localePath(lang, '/')} class="hover:text-text">{t(lang, 'breadcrumb.home')}</a>
      <span aria-hidden="true">/</span>
      <a href={localePath(lang, '/skills/')} class="hover:text-text">{t(lang, 'breadcrumb.skills')}</a>
      <span aria-hidden="true">/</span>
      {cat && <span class="text-text">{skillCategoryName(cat, lang)}</span>}
    </nav>

    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <h1 class="title-h1 text-3xl font-bold tracking-tight">{skill.name}</h1>
        <div class="mt-3 flex flex-wrap items-center gap-2">
          <span
            class={['rounded-full px-2.5 py-0.5 text-xs font-medium', sourceClass[skill.source]].join(' ')}
          >
            {sourceLabel}
          </span>
          {cat && (
            <span class="rounded-full bg-surface-2 px-2.5 py-0.5 text-xs text-muted">
              {skillCategoryName(cat, lang)}
            </span>
          )}
        </div>
      </div>
      {skill.url && (
        <a
          href={skill.url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-10 items-center rounded-full bg-accent px-5 text-sm font-semibold text-accent-ink transition hover:bg-accent-strong"
        >
          {t(lang, 'skills.source')} <span aria-hidden="true">↗</span>
        </a>
      )}
    </div>

    <p class="mt-5 leading-relaxed text-muted">{desc}</p>

    {(skill.tags ?? []).length > 0 && (
      <div class="mt-5 flex flex-wrap gap-1.5">
        {(skill.tags ?? []).map((tag) => (
          <span class="rounded-full bg-surface-2 px-2.5 py-0.5 font-mono text-xs text-muted">
            #{tag}
          </span>
        ))}
      </div>
    )}

    {useCases.length > 0 && (
      <section class="mt-10">
        <h2 class="title-h2 mb-4 text-lg font-semibold tracking-tight">{t(lang, 'skills.useCases')}</h2>
        <ul class="space-y-2.5">
          {useCases.map((useCase) => (
            <li class="flex items-start gap-3 text-sm leading-relaxed text-muted">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
              {useCase}
            </li>
          ))}
        </ul>
      </section>
    )}

    {skill.install && (
      <section class="mt-10">
        <h2 class="title-h2 mb-3 text-lg font-semibold tracking-tight">{t(lang, 'skills.install')}</h2>
        <code
          class="block overflow-x-auto rounded-2xl border border-border bg-surface-2 px-4 py-3 font-mono text-sm"
        >
          {skill.install}
        </code>
      </section>
    )}

    {related.length > 0 && (
      <section class="mt-12">
        <h2 class="title-h2 mb-4 text-lg font-semibold tracking-tight">{t(lang, 'skills.related')}</h2>
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((item) => (
            <SkillCard skill={item} lang={lang} />
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>

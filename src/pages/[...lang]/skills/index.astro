---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SkillCard from '../../../components/SkillCard.astro';
import {
  getSkillSections,
  skillCategoryDesc,
  skillCategoryName,
} from '../../../lib/skills';
import { t } from '../../../lib/i18n';
import type { Lang } from '../../../lib/types';

export function getStaticPaths() {
  return [
    { params: { lang: undefined } }, // zh → /skills/
    { params: { lang: 'en' } }, // en → /en/skills/
  ];
}

const lang: Lang = (Astro.params.lang as Lang | undefined) ?? 'zh';
const sections = getSkillSections();
---

<BaseLayout lang={lang} title={t(lang, 'skills.title')} canonicalPath="/skills/" ogType="website">
  <div class="mx-auto max-w-6xl px-4 pt-14 pb-20 sm:px-6">
    <div class="max-w-2xl">
      <h1 class="title-h1 text-3xl font-bold tracking-tight sm:text-4xl">
        {t(lang, 'skills.title')}
      </h1>
      <p class="mt-3 text-base leading-relaxed text-muted">{t(lang, 'skills.subtitle')}</p>
      <p class="mt-4 inline-flex items-center gap-2 rounded-full bg-surface-2 px-3 py-1.5 text-xs text-muted">
        <span aria-hidden="true">⌘</span>
        {t(lang, 'skills.installHint')}
      </p>
    </div>

    <div class="mt-8">
      <input
        type="search"
        enterkeyhint="search"
        autocomplete="off"
        placeholder={t(lang, 'search.placeholderSkill')}
        data-search=".skill-card"
        data-search-section=".skill-group"
        data-count="skill-count"
        class="w-full rounded-xl border border-border bg-surface py-2.5 pl-4 pr-4 text-sm outline-none transition placeholder:text-muted focus:border-accent"
      />
      <p class="mt-2 text-sm text-muted" hidden>
        <span id="skill-count" class="tabular-nums"></span>
      </p>
    </div>

    <div class="mt-10 space-y-14">
      {sections.map(({ category, skills }) => (
        <section class="skill-group scroll-mt-20">
          <h2 class="title-h2 text-lg font-semibold tracking-tight">
            {skillCategoryName(category, lang)}
          </h2>
          {skillCategoryDesc(category, lang) && (
            <p class="mb-4 mt-1 text-sm text-muted">{skillCategoryDesc(category, lang)}</p>
          )}
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {skills.map((skill) => (
              <SkillCard skill={skill} lang={lang} />
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>

  <script>
    import '../../../scripts/searchCards.ts';
  </script>
</BaseLayout>

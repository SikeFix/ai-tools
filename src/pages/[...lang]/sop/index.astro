---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SopCard from '../../../components/SopCard.astro';
import { getSopArticles, getSopsByGroup, type SopGroupId } from '../../../lib/sop';
import { t, localePath } from '../../../lib/i18n';
import { SITE_URL } from '../../../consts';
import type { Lang } from '../../../lib/types';

export function getStaticPaths() {
  return [
    { params: { lang: undefined } }, // zh → /sop/
    { params: { lang: 'en' } }, // en → /en/sop/
  ];
}

const lang: Lang = (Astro.params.lang as Lang | undefined) ?? 'zh';
const groups = getSopsByGroup(lang);
const chainSteps = t(lang, 'sop.chain').split(' → ');
const sopTotal = groups.reduce((sum, group) => sum + group.articles.length, 0);

const groupKey = (group: SopGroupId) => `sop.group.${group}` as const;
const groupDescKey = (group: SopGroupId) => `sop.group.${group}.desc` as const;
---

<BaseLayout
  lang={lang}
  title={t(lang, 'sop.title')}
  description={t(lang, 'sop.subtitle')}
  canonicalPath="/sop/"
  ogType="website"
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'ItemList',
        name: t(lang, 'sop.title'),
        itemListElement: getSopArticles(lang).map((article, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: article.title,
          url: SITE_URL + localePath(lang, `/sop/${article.slug}/`),
        })),
      })}
    />
  </Fragment>
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.14em] text-muted">
      <span class="live-dot h-1.5 w-1.5 rounded-full" aria-hidden="true"></span>
      {t(lang, 'hero.badge')}
    </div>
    <h1 class="title-h1 mt-3 text-3xl font-bold tracking-tight sm:text-4xl">{t(lang, 'sop.title')}</h1>
    <p class="mt-3 max-w-2xl text-base leading-relaxed text-muted">{t(lang, 'sop.subtitle')}</p>
    <div class="mt-5 flex items-baseline gap-1.5 text-sm text-muted">
      <span class="text-2xl font-semibold tabular-nums text-text">{sopTotal}</span>
      {t(lang, 'hero.statsSops')}
    </div>

    <!-- 核心链路横幅（视频主链路） -->
    <div
      class="mt-8 rounded-3xl border border-border bg-surface p-6 shadow-card"
      role="img"
      aria-label={t(lang, 'sop.chain')}
    >
      <ol class="flex flex-wrap items-center justify-center gap-x-2 gap-y-3 text-sm font-semibold">
        {chainSteps.map((step, i) => (
          <>
            <li class="rounded-full bg-accent/10 px-3.5 py-1.5 text-accent">{step}</li>
            {i < chainSteps.length - 1 && (
              <li aria-hidden="true" class="text-faint">→</li>
            )}
          </>
        ))}
      </ol>
      <p class="mx-auto mt-4 max-w-2xl text-center text-sm leading-relaxed text-muted">
        {t(lang, 'sop.chainNote')}
      </p>
    </div>

    <!-- 搜索 -->
    <div class="mt-8">
      <div class="relative">
        <svg
          class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-muted"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
        <input
          type="search"
          enterkeyhint="search"
          autocomplete="off"
          placeholder={t(lang, 'search.placeholderSop')}
          data-search=".sop-card"
          data-search-section=".sop-group"
          data-count="search-count"
          class="w-full rounded-xl border border-border bg-surface py-2.5 pl-9 pr-4 text-sm outline-none transition placeholder:text-muted focus:border-accent"
        />
      </div>
      <p class="mt-2 text-sm text-muted" hidden>
        <span id="search-count" class="tabular-nums"></span>
      </p>
    </div>

    <!-- 按类型分组 -->
    <div class="mt-10 space-y-14">
      {groups.map(({ group, articles }) =>
        articles.length > 0 ? (
          <section class="sop-group scroll-mt-20" id={group}>
            <h2 class="title-h2 flex items-baseline gap-2 text-xl font-semibold tracking-tight">
              {t(lang, groupKey(group))}
              <span class="text-sm font-normal tabular-nums text-muted">{articles.length}</span>
            </h2>
            <p class="mb-5 mt-1 text-sm text-muted">{t(lang, groupDescKey(group))}</p>
            <div class="grid gap-4 sm:grid-cols-3">
              {articles.map((article) => (
                <SopCard article={article} lang={lang} />
              ))}
            </div>
          </section>
        ) : null,
      )}
    </div>
  </div>

  <script>
    import '../../../scripts/searchCards.ts';
  </script>
</BaseLayout>

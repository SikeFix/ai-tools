---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ViableResourceCard from '../../../components/ViableResourceCard.astro';
import Callout from '../../../components/Callout.astro';
import {
  formatStars,
  getViableCategories,
  getViableResources,
  getViableTeaching,
  viableCategoryName,
  viableResourceDesc,
  viableTeachingAudience,
  viableTeachingIntro,
  viableTeachingPractice,
  viableTeachingSections,
} from '../../../lib/viable';
import { getSopArticles, getSopGroup } from '../../../lib/sop';
import { t, localePath } from '../../../lib/i18n';
import { SITE_URL } from '../../../consts';
import type { Lang } from '../../../lib/types';

export function getStaticPaths() {
  const langs: Array<Lang | undefined> = [undefined, 'en'];
  return langs.flatMap((lang) =>
    getViableResources().map((resource) => ({
      params: { lang, slug: resource.slug },
      props: { resource },
    })),
  );
}

const { resource } = Astro.props;
const lang: Lang = (Astro.params.lang as Lang | undefined) ?? 'zh';
const canonicalPath = `/viable-coding/${resource.slug}/`;
const teaching = getViableTeaching(resource.slug);
const intro = teaching ? viableTeachingIntro(teaching, lang) : viableResourceDesc(resource, lang);
const audience = teaching ? viableTeachingAudience(teaching, lang) : undefined;
const sections = teaching ? viableTeachingSections(teaching, lang) : [];
const practice = teaching ? viableTeachingPractice(teaching, lang) : [];
const cat = getViableCategories().find((c) => c.id === resource.category);
const related = getViableResources()
  .filter((r) => r.category === resource.category && r.slug !== resource.slug)
  .slice(0, 6);
const codingSops = getSopArticles(lang).filter((a) => getSopGroup(a.slug) === 'coding');

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t(lang, 'breadcrumb.home'), item: SITE_URL },
    {
      '@type': 'ListItem',
      position: 2,
      name: t(lang, 'breadcrumb.viableCoding'),
      item: SITE_URL + localePath(lang, '/viable-coding/'),
    },
    ...(cat
      ? [
          {
            '@type': 'ListItem',
            position: 3,
            name: viableCategoryName(cat, lang),
            item: SITE_URL + localePath(lang, '/viable-coding/'),
          },
        ]
      : []),
    {
      '@type': 'ListItem',
      position: cat ? 4 : 3,
      name: resource.name,
      item: SITE_URL + localePath(lang, canonicalPath),
    },
  ],
};
---

<BaseLayout
  lang={lang}
  title={resource.name}
  description={intro}
  canonicalPath={canonicalPath}
  ogType="article"
  ogSection={cat ? viableCategoryName(cat, lang) : undefined}
  ogTags={resource.tags ?? []}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)} />
  </Fragment>

  <div class="reveal mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <!-- 面包屑 -->
    <nav class="mb-6 flex flex-wrap items-center gap-1.5 text-sm text-muted" aria-label="Breadcrumb">
      <a href={localePath(lang, '/')} class="hover:text-text">{t(lang, 'breadcrumb.home')}</a>
      <span aria-hidden="true">/</span>
      <a href={localePath(lang, '/viable-coding/')} class="hover:text-text">
        {t(lang, 'breadcrumb.viableCoding')}
      </a>
      <span aria-hidden="true">/</span>
      {cat && <a href={localePath(lang, '/viable-coding/')} class="hover:text-text">{viableCategoryName(cat, lang)}</a>}
    </nav>

    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <h1 class="title-h1 text-3xl font-bold tracking-tight">{resource.name}</h1>
        <div class="mt-3 flex flex-wrap items-center gap-2">
          <span class="inline-flex items-center gap-1 rounded-full bg-surface-2 px-2.5 py-0.5 font-mono text-xs text-muted">
            ★ {formatStars(resource.stars)}
          </span>
          {cat && (
            <span class="rounded-full bg-accent/10 px-2.5 py-0.5 text-xs font-medium text-accent">
              {viableCategoryName(cat, lang)}
            </span>
          )}
        </div>
      </div>
      <a
        href={resource.url}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex h-10 shrink-0 items-center rounded-full bg-accent px-5 text-sm font-semibold text-accent-ink transition hover:bg-accent-strong"
      >
        {t(lang, 'vc.detail.source')} <span aria-hidden="true">↗</span>
      </a>
    </div>

    {(resource.tags ?? []).length > 0 && (
      <div class="mt-4 flex flex-wrap gap-1.5">
        {(resource.tags ?? []).map((tag) => (
          <span class="rounded-full bg-surface-2 px-2.5 py-0.5 font-mono text-xs text-muted">
            #{tag}
          </span>
        ))}
      </div>
    )}

    <!-- 简介 -->
    <section class="mt-8">
      <h2 class="title-h2 text-lg font-semibold tracking-tight">{t(lang, 'vc.detail.intro')}</h2>
      <div class="mt-3">
        <Callout tone="info">{intro}</Callout>
      </div>
    </section>

    <!-- 适合人群 -->
    {audience && (
      <section class="mt-8">
        <h2 class="title-h2 text-lg font-semibold tracking-tight">{t(lang, 'vc.detail.audience')}</h2>
        <p class="mt-3 text-sm leading-relaxed text-muted">{audience}</p>
      </section>
    )}

    <!-- 核心内容 -->
    {sections.length > 0 && (
      <section class="mt-8">
        <h2 class="title-h2 text-lg font-semibold tracking-tight">{t(lang, 'vc.detail.sections')}</h2>
        <ol class="mt-4 space-y-4">
          {sections.map((section, i) => (
            <li class="rounded-2xl border border-border bg-surface p-5">
              <h3 class="flex items-baseline gap-2.5 font-semibold tracking-tight">
                <span class="font-mono text-sm font-semibold text-accent">
                  {String(i + 1).padStart(2, '0')}
                </span>
                {section.title}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{section.body}</p>
            </li>
          ))}
        </ol>
      </section>
    )}

    <!-- 实践建议 -->
    {practice.length > 0 && (
      <section class="mt-8">
        <h2 class="title-h2 text-lg font-semibold tracking-tight">{t(lang, 'vc.detail.practice')}</h2>
        <ul class="mt-4 space-y-2.5">
          {practice.map((item) => (
            <li class="flex items-start gap-3 text-sm leading-relaxed text-muted">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
              {item}
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- 配套工作流 -->
    {codingSops.length > 0 && (
      <section class="mt-8">
        <h2 class="title-h2 text-lg font-semibold tracking-tight">{t(lang, 'vc.detail.workflows')}</h2>
        <div class="mt-3 flex flex-wrap gap-2">
          {codingSops.map((article) => (
            <a
              href={localePath(lang, `/sop/${article.slug}/`)}
              class="chip hover:border-accent hover:text-accent"
            >
              {article.title}
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- 同类资源 -->
    {related.length > 0 && (
      <section class="mt-12">
        <h2 class="title-h2 text-lg font-semibold tracking-tight">{t(lang, 'vc.detail.related')}</h2>
        <div class="mt-4 grid gap-3 sm:grid-cols-2">
          {related.map((item) => (
            <ViableResourceCard resource={item} lang={lang} />
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>

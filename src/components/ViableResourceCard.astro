---
import type { Lang, ViableResource } from '../lib/types';
import { formatStars, viableResourceDesc } from '../lib/viable';
import { localePath, t } from '../lib/i18n';

interface Props {
  resource: ViableResource;
  lang: Lang;
}

const { resource, lang } = Astro.props;
const desc = viableResourceDesc(resource, lang);
const href = localePath(lang, `/viable-coding/${resource.slug}/`);
---

<article class="viable-card flex flex-col rounded-2xl border border-border bg-surface p-5 shadow-card transition duration-200 hover:-translate-y-1 hover:shadow-lift">
  <div class="flex items-start justify-between gap-2">
    <h3 class="title-h3 font-semibold leading-snug">
      <a href={href} class="transition hover:text-accent">{resource.name}</a>
    </h3>
    <span
      class="inline-flex shrink-0 items-center gap-1 whitespace-nowrap rounded-full bg-surface-2 px-2 py-0.5 font-mono text-xs text-muted"
      title="GitHub Stars"
    >
      <span aria-hidden="true">★</span>
      {formatStars(resource.stars)}
    </span>
  </div>

  <p class="mt-2 flex-1 text-sm leading-relaxed text-muted">{desc}</p>

  <div class="mt-4 flex flex-wrap items-center justify-between gap-2 border-t border-border pt-3">
    <div class="flex flex-wrap gap-1.5">
      {(resource.tags ?? []).slice(0, 3).map((tag) => (
        <span class="rounded-full bg-surface-2 px-2 py-0.5 font-mono text-[11px] text-muted">
          #{tag}
        </span>
      ))}
    </div>
    <div class="flex items-center gap-3">
      <a
        href={href}
        class="text-xs font-medium text-accent hover:underline"
      >
        {t(lang, 'vc.learnMore')} <span aria-hidden="true">→</span>
      </a>
      <a
        href={resource.url}
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs font-medium text-muted transition hover:text-accent hover:underline"
        aria-label={t(lang, 'vc.viewSource')}
      >
        GitHub <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</article>

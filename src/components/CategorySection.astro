---
import type { Category, Lang, Tool } from '../lib/types';
import { categoryDesc, categoryName } from '../lib/tools';
import { t } from '../lib/i18n';
import ToolGrid from './ToolGrid.astro';

interface Props {
  category: Category;
  tools: Tool[];
  lang: Lang;
}

const { category, tools, lang } = Astro.props;
const id = `cat-${category.id}`;
const desc = categoryDesc(category, lang);
---

<section class="category-section scroll-mt-20" id={id}>
  <div class="mb-4">
    <h2 class="title-h2 flex items-baseline gap-2 text-lg font-semibold tracking-tight">
      <a href={`#${id}`} class="hover:text-accent">{categoryName(category, lang)}</a>
      <span class="text-sm font-normal tabular-nums text-muted">
        {tools.length} {t(lang, 'hero.statsTools')}
      </span>
    </h2>
    {desc && <p class="mt-1 text-sm text-muted">{desc}</p>}
  </div>

  {tools.length > 0 ? (
    <ToolGrid tools={tools} lang={lang} />
  ) : (
    <p class="text-sm text-muted">{t(lang, 'result.empty')}</p>
  )}
</section>

---
import type { Lang, SopStep } from '../lib/types';

interface Props {
  step: SopStep;
  index: number;
  lang: Lang;
}

const { step, index } = Astro.props;
---

<div class="flex gap-4 p-5 sm:gap-5 sm:p-6">
  <span
    class="mt-0.5 w-6 shrink-0 text-center text-sm font-semibold tabular-nums text-faint"
    aria-hidden="true"
  >
    {index + 1}
  </span>

  <div class="min-w-0 flex-1">
    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <h3 class="title-h3 font-semibold">{step.title}</h3>
      {step.time && <span class="text-xs tabular-nums text-muted">{step.time}</span>}
    </div>

    {step.tool && (
      <p class="mt-1 text-sm font-medium text-accent">
        {step.toolUrl ? (
          <a
            href={step.toolUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:underline"
          >
            {step.tool} <span aria-hidden="true">↗</span>
          </a>
        ) : (
          step.tool
        )}
      </p>
    )}

    <p class="mt-2 text-sm leading-relaxed text-muted">{step.detail}</p>

    {step.tips && (
      <p class="mt-3 rounded-xl bg-accent/10 px-3 py-2 text-sm leading-relaxed text-accent">
        <span class="mr-1 font-semibold">💡</span>
        {step.tips}
      </p>
    )}
  </div>
</div>

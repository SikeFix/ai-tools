---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { htmlLang, localePath, ogLocale, t } from '../lib/i18n';
import { SITE_DESCRIPTION, SITE_NAME, SITE_URL } from '../consts';
import type { Lang } from '../lib/types';
import '../styles/global.css';

interface Props {
  lang: Lang;
  /** 页面标题（不含站点名后缀） */
  title?: string;
  description?: string;
  /** 不带语言前缀的路径，如 /tools/sora/ */
  canonicalPath?: string;
  ogType?: string;
  /** 文章分区（og/article:section，详情页用） */
  ogSection?: string;
  /** 文章标签（og/article:tag，详情页用） */
  ogTags?: string[];
}

const {
  lang,
  title,
  description,
  canonicalPath = '/',
  ogType = 'website',
  ogSection,
  ogTags = [],
} = Astro.props;

const fullTitle = title ? `${title} · ${SITE_NAME[lang]}` : SITE_NAME[lang];
const desc = description ?? SITE_DESCRIPTION[lang];
const url = SITE_URL + localePath(lang, canonicalPath);
const urlZh = SITE_URL + localePath('zh', canonicalPath);
const urlEn = SITE_URL + localePath('en', canonicalPath);
const ogLocaleAlt = lang === 'zh' ? 'en_US' : 'zh_CN';
---

<!doctype html>
<html lang={htmlLang(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={url} />
    <link rel="alternate" hreflang="zh-CN" href={urlZh} />
    <link rel="alternate" hreflang="en" href={urlEn} />
    <link rel="alternate" hreflang="x-default" href={SITE_URL} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME[lang]} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={SITE_URL + '/og-image.png'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:locale" content={ogLocale(lang)} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f5f5f7" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#000000" />
    {ogSection && <meta property="article:section" content={ogSection} />}
    {ogTags.map((tag) => <meta property="article:tag" content={tag} />)}
    <script is:inline>
      // 主题：默认跟随系统，可手动覆盖（防 FOUC，必须在 body 前执行）
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          var dark = saved
            ? saved === 'dark'
            : window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.classList.toggle('dark', dark);
        } catch (e) {
          /* localStorage 不可用时静默降级为跟随系统 */
        }
      })();
    </script>
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col bg-bg text-text">
    <Header lang={lang} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />

    <button
      id="back-to-top"
      type="button"
      aria-label={t(lang, 'common.backToTop')}
      hidden
      class="fixed bottom-6 right-6 z-50 grid h-10 w-10 place-items-center rounded-full border border-border bg-surface shadow-card transition hover:bg-surface-2"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m18 15-6-6-6 6"></path>
      </svg>
    </button>

    <script>
      import '../scripts/backToTop.ts';
    </script>
  </body>
</html>
